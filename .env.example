# Private key of the deploying account. Testnet uses this same key to own governance at launch and to issue attestations.
PRIVATE_KEY=

# RPC URLs for Robinhood Chain (official endpoints are listed at https://docs.robinhood.com/chain/)
ROBINHOOD_TESTNET_RPC=
ROBINHOOD_RPC=

# Settings used to verify sources on Blockscout
ROBINHOOD_TESTNET_BLOCKSCOUT_API=
ROBINHOOD_BLOCKSCOUT_API=
BLOCKSCOUT_API_KEY=unused

# Governance settings, all of which may be left at their defaults
GOV=
GUARDIAN=
TIMELOCK_DELAY=3600
FINISH_BOOTSTRAP=false

# Third-party contract addresses. On testnet, leaving these empty makes the script deploy mocks (DEPLOY_MOCKS is true by default on any chain other than mainnet).
USDG=
STOCK_TOKEN=
STOCK_FEED=
SEQUENCER_FEED=
MARKET_STATUS_SOURCE=
STREAM_ADAPTER=
ATTESTATION_ISSUER=
